    def train_model(self, model, env, model_name: str, seed: int) -> Dict[str, List]:
        """
        训练模型并记录训练曲线
        """
        training_stats = {
            'episode_rewards': [],
            'valuation_accuracy': [],
            'convergence_steps': [],
            'timestamps': []
        }
        
        start_time = time.time()
        
        for episode in range(self.num_episodes):
            # 训练一个episode
            episode_stats = model.train_episode(env)
            
            # 记录训练统计
            training_stats['episode_rewards'].append(episode_stats.get('episode_reward', 0))
            training_stats['timestamps'].append(time.time() - start_time)
            
            # 定期评估
            if episode % self.eval_frequency == 0:
                eval_metrics = self.evaluate_during_training(model, env)
                training_stats['valuation_accuracy'].append(eval_metrics.get('spearman_correlation', 0))
                
                # 检查收敛
                if self.check_convergence(training_stats['episode_rewards']):
                    training_stats['convergence_steps'].append(episode)
        
        return training_stats
    
    def evaluate_during_training(self, model, env) -> Dict[str, float]:
        """
        训练过程中的评估
        """
        # 在验证集上评估模型
        eval_metrics = model.evaluate(env.get_validation_set())
        return eval_metrics
    
    def check_convergence(self, rewards: List[float], window: int = 100, threshold: float = 0.95) -> bool:
        """
        检查模型是否收敛
        """
        if len(rewards) < window:
            return False
        
        recent_rewards = rewards[-window:]
        max_reward = max(rewards)
        
        # 如果最近window个episode的平均奖励达到最大奖励的threshold，则认为收敛
        return np.mean(recent_rewards) >= threshold * max_reward
    
    def evaluate_model(self, model, env, model_name: str, seed: int) -> Dict[str, float]:
        """
        全面评估模型性能
        """
        test_set = env.get_test_set()
        metrics = {}
        
        # 基础评估指标
        metrics.update(model.evaluate(test_set))
        
        # 计算额外的统计指标
        metrics.update(self.compute_additional_metrics(model, test_set))
        
        # 添加实验元数据
        metrics.update({
            'model_name': model_name,
            'seed': seed,
            'evaluation_timestamp': time.time()
        })
        
        return metrics
    
    def compute_additional_metrics(self, model, test_set) -> Dict[str, float]:
        """
        计算额外的评估指标
        """
        metrics = {}
        
        # 伪代码 - 需要根据实际的数据和模型接口实现
        try:
            # 估值稳定性 (变异系数)
            valuations = model.predict_multiple_runs(test_set, n_runs=5)
            cv = np.std(valuations) / (np.mean(valuations) + 1e-8)
            metrics['coefficient_of_variation'] = cv
            
            # 计算Gini系数
            contributions = model.get_agent_contributions(test_set)
            metrics['gini_coefficient'] = self.calculate_gini(contributions)
            
        except Exception as e:
            print(f"计算额外指标时出错: {e}")
            metrics['coefficient_of_variation'] = 0.0
            metrics['gini_coefficient'] = 0.0
            
        return metrics
    
    def calculate_gini(self, contributions: np.ndarray) -> float:
        """
        计算Gini系数
        """
        # 排序并计算累积分布
        sorted_contrib = np.sort(contributions)
        n = len(sorted_contrib)
        index = np.arange(1, n + 1)
        
        # Gini系数计算公式
        gini = (np.sum((2 * index - n - 1) * sorted_contrib)) / (n * np.sum(sorted_contrib))
        return gini
    
    def run_comparative_experiment(self, 
                                 models: Dict[str, Any],
                                 env_config: Dict,
                                 model_configs: Dict[str, Dict]) -> Dict[str, Any]:
        """
        运行完整的对比实验
        """
        print(f"Starting comparative experiment: {self.experiment_name}")
        print(f"Number of seeds: {self.num_seeds}")
        print(f"Number of episodes: {self.num_episodes}")
        print(f"Models: {list(models.keys())}")
        
        all_results = {}
        
        for model_name, model_class in models.items():
            print(f"\n=== Training {model_name} ===")
            
            model_results = []
            model_config = model_configs.get(model_name, {})
            
            for seed in range(self.num_seeds):
                result = self.run_single_experiment(
                    model_class, model_name, seed, env_config, model_config)
                model_results.append(result)
                
                print(f"Seed {seed} completed - Final Reward: {result['final_metrics'].get('episode_reward', 0):.3f}")
            
            all_results[model_name] = model_results
            
            # 保存中间结果
            self.save_intermediate_results(all_results, model_name)
        
        self.results = all_results
        
        # 进行统计分析
        self.perform_statistical_analysis()
        
        # 生成可视化
        self.generate_visualizations()
        
        return all_results
    
    def perform_statistical_analysis(self):
        """
        进行统计显著性检验
        """
        print("\n=== Performing Statistical Analysis ===")
        
        # 提取关键指标
        key_metrics = ['spearman_correlation', 'mae', 'mse', 'gini_coefficient', 'convergence_episodes']
        
        for metric in key_metrics:
            metric_data = {}
            
            # 收集各模型的指标数据
            for model_name, results in self.results.items():
                metric_values = [r['final_metrics'].get(metric, 0) for r in results]
                metric_data[model_name] = metric_values
            
            # 进行ANOVA检验
            f_stat, p_value = stats.f_oneway(*metric_data.values())
            
            self.statistical_tests[metric] = {
                'f_statistic': f_stat,
                'p_value': p_value,
                'metric_data': metric_data
            }
            
            print(f"{metric}: F={f_stat:.4f}, p={p_value:.4f}")
            
            # 如果ANOVA显著，进行事后检验
            if p_value < 0.05:
                self.perform_posthoc_tests(metric, metric_data)
    
    def perform_posthoc_tests(self, metric: str, metric_data: Dict[str, List]):
        """
        进行事后检验 (Tukey HSD)
        """
        try:
            from statsmodels.stats.multicomp import pairwise_tukeyhsd
            
            # 准备数据
            data = []
            groups = []
            for model_name, values in metric_data.items():
                data.extend(values)
                groups.extend([model_name] * len(values))
            
            # Tukey HSD检验
            tukey = pairwise_tukeyhsd(data, groups, alpha=0.05)
            
            self.statistical_tests[metric]['posthoc'] = {
                'summary': str(tukey),
                'reject': tukey.reject,
                'pvalues': tukey.pvalues
            }
            
            print(f"Post-hoc tests for {metric}:")
            print(tukey)
            
        except ImportError:
            print("statsmodels not available, skipping post-hoc tests")
    
    def generate_visualizations(self):
        """
        生成实验结果可视化
        """
        print("\n=== Generating Visualizations ===")
        
