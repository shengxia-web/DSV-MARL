    def run_single_experiment(self, 
                            model_class, 
                            model_name: str,
                            seed: int,
                            env_config: Dict,
                            model_config: Dict) -> Dict[str, Any]:
        """
        运行单个模型的实验
        
        参数:
            model_class: 模型类
            model_name: 模型名称
            seed: 随机种子
            env_config: 环境配置
            model_config: 模型配置
            
        返回:
            实验结果字典
        """
        print(f"Running {model_name} with seed {seed}")
        
        # 设置随机种子
        torch.manual_seed(seed)
        np.random.seed(seed)
        
        # 创建环境和模型
        env = self.create_environment(env_config)
        model = model_class(**model_config)
        
        # 训练和评估
        training_stats = self.train_model(model, env, model_name, seed)
        final_metrics = self.evaluate_model(model, env, model_name, seed)
        
        return {
            'training_stats': training_stats,
            'final_metrics': final_metrics,
            'model_weights': model.get_weights() if hasattr(model, 'get_weights') else None
        }
    
    def create_environment(self, env_config: Dict):
        """
        创建实验环境
        这里需要根据实际的环境类进行实现
        """
        # 伪代码 - 需要替换为实际的环境创建代码
        from your_environment_module import MultiAgentDataEnvironment
        
        env = MultiAgentDataEnvironment(**env_config)
