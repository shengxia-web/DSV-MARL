class MARLWithShapleyIntegration:
    """
    信用分配与策略学习的深度集成
    对应论文3.3.2节的完整实现
    """
    
    def __init__(self,
                 policy_manager,
                 credit_assignment,
                 state_dim: int,
                 action_dim: int,
                 num_agents: int,
                 gamma: float = 0.99,
                 actor_lr: float = 1e-4,
                 critic_lr: float = 1e-3,
                 clip_grad_norm: float = 0.5,
                 entropy_coef: float = 0.01,
                 value_coef: float = 0.5):
        
        self.policy_manager = policy_manager
        self.credit_assignment = credit_assignment
        self.state_dim = state_dim
        self.action_dim = action_dim
        self.num_agents = num_agents
        self.gamma = gamma
        self.clip_grad_norm = clip_grad_norm
        self.entropy_coef = entropy_coef
        self.value_coef = value_coef
        
        # 优化器
        self.actor_optimizers = [
            optim.Adam(agent.parameters(), lr=actor_lr)
            for agent in self.policy_manager.policy_networks
        ]
        
        self.critic_optimizers = [
            optim.Adam(agent.value_network.parameters(), lr=critic_lr)
            for agent in self.policy_manager.policy_networks
        ]
        
        # 信用分配优化器
        self.credit_optimizer = optim.Adam(
            self.credit_assignment.parameters(), lr=critic_lr
        )
        
        # 经验缓冲区
        self.episode_buffer = []
        self.replay_buffer = deque(maxlen=100000)
        
        # 训练统计
        self.training_stats = {
            'episode_rewards': [],
            'actor_losses': [],
            'critic_losses': [],
            'entropies': [],
            'shapley_values': []
        }
    
    def store_experience(self, 
                        state: torch.Tensor,
                        actions: List[torch.Tensor],
                        reward: float,
                        next_state: torch.Tensor,
                        done: bool,
                        info: Dict):
        """存储单步经验"""
        experience = {
            'state': state.clone(),
            'actions': [action.clone() for action in actions],
            'reward': reward,
            'next_state': next_state.clone(),
            'done': done,
            'info': info
        }
        self.episode_buffer.append(experience)
    
    def compute_advantages(self,
                         personalized_rewards: torch.Tensor,
                         state_values: torch.Tensor,
                         next_state_values: torch.Tensor,
                         dones: torch.Tensor) -> torch.Tensor:
        """
        计算优势函数 A_i(S_t, a_t^i)
        
        A_i(S_t, a_t^i) = r_i + γ V_i(S_{t+1}) - V_i(S_t)
        """
        td_target = personalized_rewards + self.gamma * next_state_values * (1 - dones.float())
        advantages = td_target - state_values
        return advantages
    
    def compute_gae_advantages(self,
                             personalized_rewards: List[torch.Tensor],
                             state_values: List[torch.Tensor],
                             next_state_values: List[torch.Tensor],
                             dones: List[torch.Tensor],
                             lambda_: float = 0.95) -> List[torch.Tensor]:
        """
        计算广义优势估计 (GAE)
        提供更稳定的优势估计
        """
        batch_size = personalized_rewards[0].shape[0]
        T = len(personalized_rewards)
        
        gae_advantages = []
        
        for agent_idx in range(self.num_agents):
            advantages = torch.zeros(batch_size, device=personalized_rewards[0].device)
            agent_advantages = []
            
            # 反向计算GAE
            for t in reversed(range(T)):
                delta = personalized_rewards[t][:, agent_idx] + \
                       self.gamma * next_state_values[t][:, agent_idx] * (1 - dones[t].float()) - \
                       state_values[t][:, agent_idx]
                
                advantages = delta + self.gamma * lambda_ * advantages * (1 - dones[t].float())
                agent_advantages.insert(0, advantages)
            
            gae_advantages.append(torch.stack(agent_advantages, dim=0))
        
        return gae_advantages
    
    def update_critic_networks(self,
                             states: torch.Tensor,
                             personalized_rewards: torch.Tensor,
                             next_states: torch.Tensor,
                             dones: torch.Tensor) -> Dict[str, float]:
        """
        更新价值网络 (Critic)
        
        L(φ_i) = E[(r_{i,t} + γ V_i(S_{t+1}) - V_i(S_t))^2]
        """
        critic_losses = {}
        
        for agent_idx, (critic_optim, policy_net) in enumerate(
            zip(self.critic_optimizers, self.policy_manager.policy_networks)):
            
            # 当前状态价值估计
            current_values = policy_net.value_network(states).squeeze()
            
            # 下一状态价值估计
            with torch.no_grad():
                next_values = policy_net.value_network(next_states).squeeze()
            
            # TD目标
            td_target = personalized_rewards[:, agent_idx] + \
                       self.gamma * next_values * (1 - dones.float())
            
            # 价值损失
            value_loss = F.mse_loss(current_values, td_target)
            
            # 反向传播
            critic_optim.zero_grad()
            value_loss.backward()
            torch.nn.utils.clip_grad_norm_(policy_net.value_network.parameters(), 
                                         self.clip_grad_norm)
            critic_optim.step()
            
            critic_losses[f'agent_{agent_idx}_critic_loss'] = value_loss.item()
        
        return critic_losses
    
    def update_actor_networks(self,
                            states: torch.Tensor,
                            actions: List[torch.Tensor],
                            advantages: torch.Tensor,
                            old_log_probs: List[torch.Tensor] = None) -> Dict[str, float]:
        """
        更新策略网络 (Actor)
        
        ∇_{θ_i} J(π_i) ≈ E[∇_{θ_i} log π_i(a_t^i | S_t) • A_i(S_t, a_t^i)]
        """
        actor_losses = {}
        entropy_losses = {}
        
        for agent_idx, (actor_optim, policy_net) in enumerate(
            zip(self.actor_optimizers, self.policy_manager.policy_networks)):
            
            # 评估当前策略下的动作
            action_dist, _ = policy_net(states)
            new_log_probs = action_dist.log_prob(actions[agent_idx])
            entropy = action_dist.entropy().mean()
            
            # 策略损失 (带重要性采样权重，如果提供了旧的对数概率)
            if old_log_probs is not None:
                ratio = torch.exp(new_log_probs - old_log_probs[agent_idx].detach())
                surrogate1 = ratio * advantages[:, agent_idx]
                surrogate2 = torch.clamp(ratio, 0.8, 1.2) * advantages[:, agent_idx]
                policy_loss = -torch.min(surrogate1, surrogate2).mean()
            else:
                policy_loss = -(new_log_probs * advantages[:, agent_idx]).mean()
            
            # 熵正则化
            entropy_loss = -self.entropy_coef * entropy
            
            # 总损失
            total_loss = policy_loss + entropy_loss
            
            # 反向传播
            actor_optim.zero_grad()
            total_loss.backward()
            torch.nn.utils.clip_grad_norm_(policy_net.parameters(), self.clip_grad_norm)
            actor_optim.step()
            
            actor_losses[f'agent_{agent_idx}_actor_loss'] = policy_loss.item()
            entropy_losses[f'agent_{agent_idx}_entropy'] = entropy.item()
        
        return {**actor_losses, **entropy_losses}
    
    def update_credit_assignment(self,
                               state_sequence: List[torch.Tensor],
                               global_reward: torch.Tensor,
                               contributions: torch.Tensor) -> Dict[str, float]:
        """
        更新信用分配网络
        通过最小化信用分配误差来优化Shapley值近似器
        """
        # 提取智能体特征序列
        feature_sequence = [
            self.credit_assignment.extract_agent_features(state) 
            for state in state_sequence
        ]
        
        # 重新计算贡献（用于训练）
        predicted_contributions = self.credit_assignment.credit_assignment.compute_temporal_contributions(
            feature_sequence)
        
        # 信用分配损失 - 确保贡献估计的一致性
        credit_loss = F.mse_loss(predicted_contributions, contributions.detach())
        
        # 添加正则化项
        monotonic_weights = self.credit_assignment.credit_assignment.shapley_approximator.mixing_network.monotonic_weights
        regularization = torch.sum(torch.abs(monotonic_weights))
        
        total_credit_loss = credit_loss + 0.001 * regularization
        
        # 反向传播
        self.credit_optimizer.zero_grad()
        total_credit_loss.backward()
        torch.nn.utils.clip_grad_norm_(self.credit_assignment.parameters(), self.clip_grad_norm)
        self.credit_optimizer.step()
        
        return {
            'credit_loss': credit_loss.item(),
            'credit_regularization': regularization.item(),
            'total_credit_loss': total_credit_loss.item()
        }
    
    def process_episode(self) -> Dict[str, Any]:
        """
        处理完整episode，进行信用分配和策略更新
        """
        if len(self.episode_buffer) == 0:
            return {}
        
        # 提取episode数据
        states = torch.stack([exp['state'] for exp in self.episode_buffer])
        actions = [
            torch.stack([exp['actions'][i] for exp in self.episode_buffer])
            for i in range(self.num_agents)
        ]
        rewards = torch.tensor([exp['reward'] for exp in self.episode_buffer])
        next_states = torch.stack([exp['next_state'] for exp in self.episode_buffer])
        dones = torch.tensor([exp['done'] for exp in self.episode_buffer])
        
        # 全局奖励（episode结束时的总奖励）
        global_reward = rewards.sum()
        
        # 转换为序列格式
        state_sequence = [states[i] for i in range(len(self.episode_buffer))]
        
        # 计算动态Shapley贡献和个性化奖励
        with torch.no_grad():
            credit_info = self.credit_assignment.compute_credits_and_rewards(
                state_sequence, global_reward.unsqueeze(0))
        
        contributions = credit_info['contributions']
        personalized_rewards = credit_info['personalized_rewards']
        
        # 扩展个性化奖励以匹配时间步
        expanded_personalized_rewards = personalized_rewards.repeat(len(self.episode_buffer), 1)
        
        # 计算状态价值
        state_values = []
        next_state_values = []
        
        for policy_net in self.policy_manager.policy_networks:
            state_vals = policy_net.value_network(states).squeeze()
            next_state_vals = policy_net.value_network(next_states).squeeze()
            state_values.append(state_vals)
            next_state_values.append(next_state_vals)
        
        state_values = torch.stack(state_values, dim=1)
        next_state_values = torch.stack(next_state_values, dim=1)
        
        # 计算优势函数
        advantages = self.compute_advantages(
            expanded_personalized_rewards, state_values, next_state_values, dones)
        
        # 更新网络
        critic_losses = self.update_critic_networks(
            states, expanded_personalized_rewards, next_states, dones)
        
        actor_losses = self.update_actor_networks(states, actions, advantages)
        
        credit_losses = self.update_credit_assignment(
            state_sequence, global_reward.unsqueeze(0), contributions)
        
        # 存储训练统计
        episode_stats = {
            'episode_reward': global_reward.item(),
            'episode_length': len(self.episode_buffer),
            'mean_contribution': contributions.mean().item(),
            'contribution_std': contributions.std().item(),
            **critic_losses,
            **actor_losses,
            **credit_losses
        }
        
        # 清空episode缓冲区
        self.episode_buffer.clear()
        
        return episode_stats
    
    def train_step(self,
                  state: torch.Tensor,
                  actions: List[torch.Tensor],
                  reward: float,
                  next_state: torch.Tensor,
                  done: bool,
                  info: Dict) -> Optional[Dict[str, Any]]:
        """
        单步训练接口
        存储经验并在episode结束时进行更新
        """
        self.store_experience(state, actions, reward, next_state, done, info)
        
        # 如果episode结束，进行处理和更新
        if done:
            episode_stats = self.process_episode()
            
            # 更新训练统计
            for key, value in episode_stats.items():
                if key not in self.training_stats:
                    self.training_stats[key] = []
                self.training_stats[key].append(value)
            
            return episode_stats
        
        return None

class PPOShapleyIntegration(MARLWithShapleyIntegration):
    """
    使用PPO算法的Shapley集成版本
    提供更稳定的策略更新
    """
    
    def __init__(self, ppo_epochs: int = 4, ppo_clip: float = 0.2, **kwargs):
        super(PPOShapleyIntegration, self).__init__(**kwargs)
        self.ppo_epochs = ppo_epochs
        self.ppo_clip = ppo_clip
        self.old_policies = None
        
    def save_old_policies(self):
        """保存旧策略用于PPO"""
        self.old_policies = []
        for policy_net in self.policy_manager.policy_networks:
            old_policy = {}
            for name, param in policy_net.named_parameters():
                if 'policy_head' in name:
                    old_policy[name] = param.data.clone()
            self.old_policies.append(old_policy)
    
    def compute_old_log_probs(self, states: torch.Tensor, actions: List[torch.Tensor]) -> List[torch.Tensor]:
        """使用旧策略计算动作的对数概率"""
        old_log_probs = []
        
        for agent_idx, policy_net in enumerate(self.policy_manager.policy_networks):
            with torch.no_grad():
                # 临时恢复旧策略参数
                if self.old_policies is not None:
                    original_params = {}
                    for name, param in policy_net.named_parameters():
                        if 'policy_head' in name and name in self.old_policies[agent_idx]:
                            original_params[name] = param.data.clone()
                            param.data.copy_(self.old_policies[agent_idx][name])
                
                # 计算旧对数概率
                action_dist, _ = policy_net(states)
                old_log_prob = action_dist.log_prob(actions[agent_idx])
                old_log_probs.append(old_log_prob)
                
                # 恢复原始参数
                if self.old_policies is not None and original_params:
                    for name, param in policy_net.named_parameters():
                        if name in original_params:
                            param.data.copy_(original_params[name])
        
        return old_log_probs
    
    def process_episode(self) -> Dict[str, Any]:
        """
        PPO版本的episode处理
        使用多轮优化和裁剪
        """
        if len(self.episode_buffer) == 0:
            return {}
        
        # 提取episode数据
        states = torch.stack([exp['state'] for exp in self.episode_buffer])
        actions = [
            torch.stack([exp['actions'][i] for exp in self.episode_buffer])
            for i in range(self.num_agents)
        ]
        rewards = torch.tensor([exp['reward'] for exp in self.episode_buffer])
        next_states = torch.stack([exp['next_state'] for exp in self.episode_buffer])
        dones = torch.tensor([exp['done'] for exp in self.episode_buffer])
        
        global_reward = rewards.sum()
        state_sequence = [states[i] for i in range(len(self.episode_buffer))]
        
        # 保存旧策略
        self.save_old_policies()
        
        # 计算旧对数概率
        old_log_probs = self.compute_old_log_probs(states, actions)
        
        # PPO多轮优化
        ppo_stats = {}
        
        for epoch in range(self.ppo_epochs):
            # 重新计算信用分配（每轮都可能变化）
            with torch.no_grad():
                credit_info = self.credit_assignment.compute_credits_and_rewards(
                    state_sequence, global_reward.unsqueeze(0))
            
            contributions = credit_info['contributions']
            personalized_rewards = credit_info['personalized_rewards']
            expanded_personalized_rewards = personalized_rewards.repeat(len(self.episode_buffer), 1)
            
            # 计算状态价值和优势
            state_values = []
            next_state_values = []
            
            for policy_net in self.policy_manager.policy_networks:
                state_vals = policy_net.value_network(states).squeeze()
                next_state_vals = policy_net.value_network(next_states).squeeze()
                state_values.append(state_vals)
                next_state_values.append(next_state_vals)
            
            state_values = torch.stack(state_values, dim=1)
            next_state_values = torch.stack(next_state_values, dim=1)
            
            advantages = self.compute_advantages(
                expanded_personalized_rewards, state_values, next_state_values, dones)
            
            # 更新网络
            if epoch == 0:
                critic_losses = self.update_critic_networks(
                    states, expanded_personalized_rewards, next_states, dones)
            
            actor_losses = self.update_actor_networks(
                states, actions, advantages, old_log_probs)
            
            credit_losses = self.update_credit_assignment(
                state_sequence, global_reward.unsqueeze(0), contributions)
            
            # 累积统计
            for key, value in {**critic_losses, **actor_losses, **credit_losses}.items():
                if key not in ppo_stats:
                    ppo_stats[key] = []
                ppo_stats[key].append(value)
        
        # 计算平均统计
        episode_stats = {
            'episode_reward': global_reward.item(),
            'episode_length': len(self.episode_buffer),
            'mean_contribution': contributions.mean().item(),
            'contribution_std': contributions.std().item(),
        }
        
        for key, values in ppo_stats.items():
            episode_stats[f'{key}_mean'] = np.mean(values)
            episode_stats[f'{key}_std'] = np.std(values)
        
        # 清空缓冲区
        self.episode_buffer.clear()
        self.old_policies = None
        
        return episode_stats

class TrainingMonitor:
    """
    训练监控和可视化工具
    """
    
    def __init__(self):
        self.history = {}
    
    def update(self, stats: Dict[str, Any]):
        """更新训练历史"""
        for key, value in stats.items():
            if key not in self.history:
                self.history[key] = []
            self.history[key].append(value)
    
    def print_progress(self, episode: int, stats: Dict[str, Any]):
        """打印训练进度"""
        print(f"Episode {episode}:")
        print(f"  Reward: {stats.get('episode_reward', 0):.3f}")
        print(f"  Length: {stats.get('episode_length', 0)}")
        print(f"  Mean Contribution: {stats.get('mean_contribution', 0):.3f}")
        
        # 打印损失信息
        for key in stats:
            if 'loss' in key.lower() and 'mean' in key:
                print(f"  {key}: {stats[key]:.4f}")

